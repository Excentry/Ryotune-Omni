# Local-source PKGBUILD for the Ryotune Omni package.
# Run from packaging/arch with: makepkg -si

pkgname=ryotune-omni
pkgver=1.2.3
pkgrel=1
pkgdesc="Ryotune Omni — independent music player"
url='https://github.com/Excentry/Ryotune-Omni'
arch=('x86_64')
license=('GPL-3.0-or-later')
depends=(
  'webkit2gtk-4.1'
  'libappindicator-gtk3'
  'mpv'
  'yt-dlp'
  'ffmpeg'
  'openssl'
  'librsvg'
  'desktop-file-utils'
  'hicolor-icon-theme'
  'xdg-utils'
  'polkit'
  # Required: the native QML client (ryotune-omni-qml) that `ryotune-omni` opens on Linux; there is no
  # Tauri fallback, so the client runtime is not optional.
  'quickshell'
)
makedepends=(
  'base-devel'
  'cargo'
  'nodejs'
  'pnpm'
  'appmenu-gtk-module'
  'xdotool'
)
install=ryotune-omni.install
# makepkg's lto option feeds -flto to the C sources cc builds for the vendored sqlite and ring;
# rustc links with lld, which cannot read GCC LTO objects (undefined sqlite3_* / ring_core_*).
# !debug: the release ships exactly one contracted asset (ryotune-omni-<ver>-1-x86_64.pkg.tar.zst),
# never a second debug package, regardless of the builder's makepkg.conf.
options=(!lto !debug)
source=()
sha256sums=()

prepare() {
  local root
  root="$(cd "$startdir/../.." && pwd)"
  rm -rf "$srcdir/ryotune-omni"
  mkdir -p "$srcdir/ryotune-omni"
  tar \
    --exclude='.git' \
    --exclude='target' \
    --exclude='ui/node_modules' \
    --exclude='ui/build' \
    --exclude='ui/.svelte-kit' \
    --exclude='./packaging/arch/pkg' \
    --exclude='./packaging/arch/src' \
    --exclude='./packaging/arch/*.pkg.tar.*' \
    -C "$root" -cf - . | tar -C "$srcdir/ryotune-omni" -xf -
}

build() {
  cd "$srcdir/ryotune-omni/ui"
  pnpm install --frozen-lockfile
  pnpm build

  cd "$srcdir/ryotune-omni"
  cargo build --release --locked --package ryotunes --package sync-server --package ryotunesd --package ryotunes-cli
}

check() {
  cd "$srcdir/ryotune-omni"
  cargo test --workspace --locked
  cd ui
  pnpm check
}

package() {
  cd "$srcdir/ryotune-omni"
  local binaries="${CARGO_TARGET_DIR:-target}/release"
  install -Dm755 "$binaries/ryotune-omni" "$pkgdir/usr/bin/ryotune-omni"
  install -Dm755 "$binaries/ryotune-omni-sync-server" "$pkgdir/usr/bin/ryotune-omni-sync-server"
  install -Dm755 "$binaries/ryotune-omni-daemon" "$pkgdir/usr/bin/ryotune-omni-daemon"
  install -Dm755 "$binaries/ryotune-omni-cli" "$pkgdir/usr/bin/ryotune-omni-cli"
  install -Dm755 packaging/linux/ryotune-omni-qml "$pkgdir/usr/bin/ryotune-omni-qml"
  # Native QML client, run by Quickshell via `qs -p /usr/share/ryotune-omni/client`; ship the
  # whole config tree minus the QtTest sources, world-readable.
  install -dm755 "$pkgdir/usr/share/ryotune-omni"
  cp -r client "$pkgdir/usr/share/ryotune-omni/client"
  rm -rf "$pkgdir/usr/share/ryotune-omni/client/tests"
  find "$pkgdir/usr/share/ryotune-omni/client" -type d -exec chmod 755 {} +
  find "$pkgdir/usr/share/ryotune-omni/client" -type f -exec chmod 644 {} +
  # Shipped skins (skin.json + preview.png + the schema/README) and the matugen template, so the
  # client's shipped skin dir (<shellDir>/../skins) and `/usr/share/ryotune-omni/matugen` resolve.
  install -dm755 "$pkgdir/usr/share/ryotune-omni/skins"
  cp -r skins/. "$pkgdir/usr/share/ryotune-omni/skins/"
  find "$pkgdir/usr/share/ryotune-omni/skins" -type d -exec chmod 755 {} +
  find "$pkgdir/usr/share/ryotune-omni/skins" -type f -exec chmod 644 {} +
  install -Dm644 matugen/ryotunes.json "$pkgdir/usr/share/ryotune-omni/matugen/ryotunes.json"
  install -Dm644 packaging/linux/ryotune-omni-daemon.socket "$pkgdir/usr/lib/systemd/user/ryotune-omni-daemon.socket"
  install -Dm644 packaging/linux/ryotune-omni-daemon.service "$pkgdir/usr/lib/systemd/user/ryotune-omni-daemon.service"
  install -Dm644 packaging/linux/90-ryotune-omni.preset "$pkgdir/usr/lib/systemd/user-preset/90-ryotune-omni.preset"
  install -Dm644 packaging/linux/ryotune-omni.desktop "$pkgdir/usr/share/applications/ryotune-omni.desktop"
  install -Dm644 packaging/linux/dev.excentry.ryotune-omni.metainfo.xml "$pkgdir/usr/share/metainfo/dev.excentry.ryotune-omni.metainfo.xml"
  install -Dm644 src-tauri/icons/32x32.png "$pkgdir/usr/share/icons/hicolor/32x32/apps/ryotune-omni.png"
  install -Dm644 src-tauri/icons/64x64.png "$pkgdir/usr/share/icons/hicolor/64x64/apps/ryotune-omni.png"
  install -Dm644 src-tauri/icons/128x128.png "$pkgdir/usr/share/icons/hicolor/128x128/apps/ryotune-omni.png"
  install -Dm644 src-tauri/icons/128x128@2x.png "$pkgdir/usr/share/icons/hicolor/256x256/apps/ryotune-omni.png"
  install -Dm644 src-tauri/icons/icon.png "$pkgdir/usr/share/icons/hicolor/512x512/apps/ryotune-omni.png"
  install -Dm755 scripts/diagnostics.sh "$pkgdir/usr/bin/ryotune-omni-diagnostics"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/ryotune-omni/LICENSE"
  install -Dm644 README.md "$pkgdir/usr/share/doc/ryotune-omni/README.md"
  install -Dm644 UPSTREAM.md "$pkgdir/usr/share/doc/ryotune-omni/UPSTREAM.md"
}
